<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon for the tracking foreground service: the launcher icon's motif — the route
     between two waypoints, the same shape the Track tab draws — redrawn as a silhouette.

     NOT the launcher bitmap itself. Android alpha-masks a notification's small icon from API 21
     on: every opaque pixel is painted white and colour is discarded, so @mipmap/ic_launcher (an
     opaque rounded square) would render as a solid white square. Only shape survives the mask,
     which is why this is a transparent-background vector carrying the same shape.

     Stroked a shade heavier than the tab icon's 1.75: at status-bar size the tab weight thins out,
     but the waypoints stay open rings rather than filled dots so the silhouette still matches the
     launcher. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:pathData="M8.6,19 h8.4 a3.5,3.5 0 0 0 0,-7 H7 a3.5,3.5 0 0 1 0,-7 h8.4"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="2"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <path
      android:pathData="M6,19 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="2" />
  <path
      android:pathData="M18,5 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="2" />
</vector>
