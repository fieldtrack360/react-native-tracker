{
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    "module": "node16",
    "target": "es2019",
    "moduleResolution": "node16",
    "strict": true,
    "declaration": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./src"
  ]
}
